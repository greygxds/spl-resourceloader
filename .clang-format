---
BasedOnStyle: LLVM

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

BreakBeforeBraces: Allman

# Access specifiers sit at the class's own indentation.
AccessModifierOffset: -4

AllowShortFunctionsOnASingleLine: Empty

PointerAlignment: Left
DerivePointerAlignment: false

SortIncludes: CaseSensitive
IncludeBlocks: Regroup

# Include order (AGENTS/CODING-CONVENTIONS.md §7):
#   0 own header (clang-format's implicit main-include, priority 0)
#   1 <std>
#   2 third-party (<spdlog/...>, <toml++/...>, <MinHook.h>, <main.h>, <Windows.h>)
#   3 project headers ("streaming/AssetType.h")
IncludeCategories:
  - Regex: '^<(spdlog|toml\+\+|catch2)/'
    Priority: 2
  - Regex: '^<(MinHook|main|natives|types|nativeCaller|Windows)\.h>$'
    Priority: 2
  - Regex: '^<catch_amalgamated\.hpp>$'
    Priority: 2
  - Regex: '^<.*\.h>$'
    Priority: 1
  - Regex: '^<.*>$'
    Priority: 1
  - Regex: '^".*"$'
    Priority: 3
