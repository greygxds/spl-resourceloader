// Windows file properties for resourceLoader.asi. The version comes from the
// header CI writes; spl_asi.vcxproj defines SPL_HAS_BUILD_VERSION when it exists, because the
// resource compiler has no __has_include.

#include <winres.h>

#ifdef SPL_HAS_BUILD_VERSION
#include "core/BuildVersion.h"
#else
#define SPL_BUILD_NUMBER 0
#define SPL_VERSION_TEXT "Development"
#define SPL_COMMIT_SHA "local"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,SPL_BUILD_NUMBER,0
 PRODUCTVERSION 0,0,SPL_BUILD_NUMBER,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Singleplayer Resource Loader for GTA V"
            VALUE "FileVersion", SPL_VERSION_TEXT
            VALUE "InternalName", "resourceLoader"
            VALUE "OriginalFilename", "resourceLoader.asi"
            VALUE "ProductName", "Singleplayer Resource Loader"
            VALUE "ProductVersion", SPL_VERSION_TEXT
            VALUE "Commit", SPL_COMMIT_SHA
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
