  <!-- Lua 5.4, built with our toolset, CRT and platform settings. Only the library is built:
       lua.c is the standalone interpreter, onelua.c an amalgamation, ltests.c an internal test
       harness. Which libraries a manifest can actually reach is decided at runtime in
       LuaManifestLoader, not here. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAs>CompileAsC</CompileAs>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>false</ConformanceMode>
      <PreprocessorDefinitions>LUA_COMPAT_5_3;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

