<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- ScriptHookV SDK. Vendored (committed) under external/scripthookv/, because it is
       not a git repository; see external/scripthookv/README.md.
       Imported only by spl_game and spl_asi. -->

  <PropertyGroup>
    <SplScriptHookVDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\external\scripthookv'))</SplScriptHookVDir>
    <ExternalIncludePath>$(SplScriptHookVDir)inc;$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>$(SplScriptHookVDir)lib\ScriptHookV.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
