      <AdditionalIncludeDirectories>$(SplRoot);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Where the manifest corpus lives, so a test does not guess at a relative path. -->
      <PreprocessorDefinitions>SPL_TEST_FIXTURES=R"($(SplRoot)tests\fixtures)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
